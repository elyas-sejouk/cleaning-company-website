---
import "../styles/global.css";
// Import heading font (Outfit) - weights 500, 600, 700
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";

// Import body font (Inter) - weights 400, 500, 600
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";

import CookieBanner from "../components/CookieBanner.astro";
import logoSvg from "../assets/logo.svg";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
}

const {
	title,
	description = "Entreprise de nettoyage professionnel spécialisée Fin de Chantier, Événementiel, Débarras & Sinistres à Narbonne, Béziers et sur l'Arc Méditerranéen. Devis gratuit sous 24h.",
	image,
	canonical,
	type = "website",
} = Astro.props;

const defaultSiteTitle = "Éclat du Sud";
const displayTitle = title ? `${title} | ${defaultSiteTitle}` : defaultSiteTitle;

const siteOrigin = Astro.site ? Astro.site.origin : "https://eclatdusud.fr";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteOrigin).href;
const logoUrl = new URL(logoSvg.src, siteOrigin).href;
const ogImageUrl = image ? new URL(image, siteOrigin).href : logoUrl;

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "CleaningService",
	"name": "Éclat du Sud",
	"url": siteOrigin,
	"logo": logoUrl,
	"image": ogImageUrl,
	"description": description,
	"priceRange": "€€",
	"address": {
		"@type": "PostalAddress",
		"addressLocality": "Narbonne",
		"addressRegion": "Occitanie",
		"addressCountry": "FR"
	},
	"areaServed": [
		"Narbonne",
		"Béziers",
		"Gruissan",
		"Lézignan-Corbières",
		"Coursan",
		"Vinassan",
		"Salles-d'Aude",
		"Colombiers",
		"Sérignan"
	],
	"openingHoursSpecification": {
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
			"Sunday"
		],
		"opens": "07:00",
		"closes": "20:00"
	}
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-DVLQKWGKSB"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-DVLQKWGKSB');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />

		<!-- Canonical Link -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Favicon -->
		<link rel="icon" type="image/png" href="/ico.png" />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={displayTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Éclat du Sud" />
		<meta property="og:locale" content="fr_FR" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={displayTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<title>{displayTitle}</title>

		<!-- Structured Data: LocalBusiness / CleaningService -->
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
	</head>

	<body class="bg-brand-gray-light text-brand-text font-sans antialiased">
		<slot />
		<CookieBanner />
	</body>
</html>

