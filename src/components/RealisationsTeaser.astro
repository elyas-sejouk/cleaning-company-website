---
import { Image } from "astro:assets";
import { published, communes, photo } from "../data/published-realisations.ts";

// Three strongest frames, chosen deliberately — see docs/adr/0004.
const highlights = [
  { slug: "coursan-2025-10-27", file: "parquet-apres", label: "Parquet ancien, Coursan" },
  { slug: "alignan-du-vent-2026-07-09", file: "sejour-autolaveuse", label: "Fin de chantier, Alignan-du-Vent" },
  { slug: "ginestas-2025-10-28", file: "fenetre-apres", label: "Vitrages, Ginestas" },
]
  .map((h) => ({ ...h, img: photo(h.slug, h.file) }))
  .filter((h) => h.img);
---

<section class="bg-brand-navy py-24 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(184,144,71,0.14),transparent_55%)] pointer-events-none"></div>

  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    <div class="md:flex md:items-end md:justify-between gap-10 mb-14">
      <div class="max-w-2xl">
        <span class="text-brand-gold text-xs font-bold uppercase tracking-widest block mb-3">
          Journal d'intervention
        </span>
        <h2 class="font-heading font-extrabold text-3xl md:text-4xl text-white mb-4">
          Nos Réalisations
        </h2>
        <p class="text-white/70 text-base font-medium leading-relaxed">
          Pas de photos d'agence : {published.length} chantiers réels, datés et localisés
          à {communes.join(", ")}. Photographiés sur place par nos équipes.
        </p>
      </div>

      <a
        href="/realisations"
        class="hidden md:inline-flex items-center gap-2 shrink-0 rounded-full border border-white/20 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white hover:bg-brand-gold hover:border-brand-gold transition-colors"
      >
        Voir le journal
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {
        highlights.map((h) => (
          <a href="/realisations" class="group block">
            <div class="overflow-hidden rounded-2xl border border-white/10">
              <Image
                src={h.img!}
                alt={`${h.label} — chantier de nettoyage réalisé par Éclat du Sud.`}
                widths={[400, 700]}
                sizes="(min-width: 640px) 340px, 100vw"
                class="block w-full h-56 object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <div class="mt-3 text-sm font-semibold text-white/80 group-hover:text-brand-gold transition-colors">
              {h.label}
            </div>
          </a>
        ))
      }
    </div>

    <a
      href="/realisations"
      class="md:hidden mt-10 inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/20 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white hover:bg-brand-gold hover:border-brand-gold transition-colors"
    >
      Voir le journal
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>
