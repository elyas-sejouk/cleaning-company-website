---
// src/components/FAQ.astro
const questions = [
  {
    q: "Comment est calculé le tarif d'un Devis chez Éclat du Sud ?",
    a: "Le tarif est calculé selon la surface en m², l'état initial des lieux, le type de prestation (Fin de chantier, Événementiel, Débarras, Sinistre) et le volume de déchets ou gravats à évacuer. Nous fournissons une estimation détaillée et transparente sous 24h.",
  },
  {
    q: "Fournissez-vous l'intégralité du matériel et des produits de nettoyage ?",
    a: "Absolument. Nos équipes interviennent équipées d'aspirateurs industriels eau/poussière, de monobrosses, de nettoyeurs haute pression et de produits professionnels éco-responsables. Vous n'avez aucun équipement ni produit d'entretien à fournir.",
  },
  {
    q: "Intervenez-vous le week-end ou en urgence après sinistre ?",
    a: "Oui, nous sommes disponibles 7j/7 et nous assurons des interventions d'urgence (inondation, dégât des eaux, événements, fin de chantier avec livraison imminente) sur Narbonne, Béziers et les communes environnantes.",
  },
  {
    q: "Travaillez-vous avec les professionnels (B2B) et les particuliers ?",
    a: "Oui, nous accompagnons les professionnels du bâtiment, promoteurs, conciergeries Airbnb, agences immobilières ainsi que les particuliers pour leurs logements secondaires, déménagements ou nettoyages de printemps.",
  },
  {
    q: "Prenez-vous en charge l'évacuation des gravats et encombrants vers la déchetterie ?",
    a: "Oui. Dans le cadre de nos prestations Débarras et Fin de Chantier, nous assurons la manutention, le tri sélectif et l'évacuation en déchetterie agréée avec bordereau de suivi.",
  },
  {
    q: "Êtes-vous assurés en cas de dommage accidentel ?",
    a: "Oui, Éclat du Sud dispose d'une assurance Responsabilité Civile Professionnelle (RC Pro) complète. Vos locaux, matériaux et biens sont intégralement protégés pendant nos interventions.",
  },
  {
    q: "Quelles sont les villes couvertes par vos prestations ?",
    a: "Nous couvrons principalement Narbonne, Béziers, Gruissan, Lézignan-Corbières, Coursan, Vinassan, Salles-d'Aude, Colombiers, Sérignan et l'ensemble du bassin de l'Arc Méditerranéen.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": questions.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<section id="faq" class="bg-white py-24 border-b border-brand-gray-border/60">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container mx-auto px-6 max-w-3xl">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-brand-gold text-xs font-bold uppercase tracking-widest block mb-2">Réponses Rapides</span>
      <h2 class="font-heading font-extrabold text-3xl text-brand-navy">
        Questions Fréquentes
      </h2>
    </div>

    <div class="space-y-4">
      {
        questions.map((item) => (
          <details class="group bg-white border border-brand-gray-border rounded-xl overflow-hidden cursor-pointer shadow-sm hover:shadow-md transition-all duration-300">
            <summary class="flex justify-between items-center p-6 font-semibold text-lg text-brand-navy hover:text-brand-gold list-none select-none transition-colors">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-brand-gold transition-transform duration-300 group-open:rotate-180 shrink-0 ml-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>

            <div class="p-6 pt-0 text-brand-text-muted leading-relaxed border-t border-brand-gray-border/40 bg-brand-gray-light/20">
              <p class="text-base font-medium">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
