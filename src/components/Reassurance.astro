---
// src/components/Reassurance.astro
const points = [
  {
    title: "Devis Gratuit 24h",
    desc: "Estimation rapide, claire et transparente sans aucun engagement.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    title: "Intervention Rapide",
    desc: "Disponibilité 7j/7 selon vos contraintes et vos urgences.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    title: "Matériel Pro Inclus",
    desc: "Aspirateurs industriels et produits professionnels éco-responsables.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`
  },
  {
    title: "Personnel Qualifié",
    desc: "Équipes formées, rigoureuses et attentives aux moindres détails.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`
  },
  {
    title: "Assurance RC Pro",
    desc: "Vos locaux et votre logement sont totalement assurés et protégés.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    title: "Pro & Particuliers",
    desc: "Adapté aux gestionnaires de biens, chantiers, commerces et résidences.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0H9" />`
  }
];
---

<section class="bg-brand-navy py-16 text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(184,144,71,0.1),transparent_50%)] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-brand-gold text-xs font-bold uppercase tracking-widest block mb-2">Garanties & Engagements</span>
      <h2 class="font-heading font-extrabold text-2xl md:text-4xl text-white">
        Pourquoi choisir <span class="text-brand-gold">Éclat du Sud</span> ?
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {
        points.map((item) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-gold/40 hover:bg-white/10 transition-all duration-300 group flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" fragment={item.icon}>
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-gold transition-colors">{item.title}</h3>
              <p class="text-slate-300 text-sm leading-relaxed font-medium">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
