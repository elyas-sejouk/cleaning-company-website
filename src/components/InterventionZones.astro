---
// src/components/InterventionZones.astro
const primaryCities = [
  { name: "Narbonne", dept: "Aude (11)", tag: "Secteur Principal" },
  { name: "Béziers", dept: "Hérault (34)", tag: "Intervention Express" },
  { name: "Gruissan", dept: "Aude (11)", tag: "Littoral & Saisonniers" },
  { name: "Lézignan-Corbières", dept: "Aude (11)", tag: "Corbières & Environs" },
  { name: "Coursan", dept: "Aude (11)", tag: "Grand Narbonne" },
  { name: "Vinassan", dept: "Aude (11)", tag: "Clape & Narbonnais" },
  { name: "Salles-d'Aude", dept: "Aude (11)", tag: "Val de Dagne" },
  { name: "Colombiers", dept: "Hérault (34)", tag: "Canal du Midi" },
  { name: "Sérignan", dept: "Hérault (34)", tag: "Littoral Héraultais" }
];
---

<section id="zones" class="bg-white py-20 border-b border-brand-gray-border/60">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-brand-gold text-xs font-bold uppercase tracking-widest block mb-2">Proximité & Réactivité</span>
      <h2 class="font-heading font-extrabold text-3xl md:text-4xl text-brand-navy mb-4">
        Nos Zones d'Intervention
      </h2>
      <p class="text-brand-text-muted text-base font-medium leading-relaxed">
        Nos équipes mobiles interviennent sur l'ensemble du bassin de <strong>Narbonne</strong>, de <strong>Béziers</strong> et du littoral méditerranéen pour toutes vos prestations de nettoyage et débarras.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        primaryCities.map((city) => (
          <div class="bg-brand-gray-light/50 border border-brand-gray-border/80 p-5 rounded-xl flex items-center gap-4 hover:border-brand-gold/50 hover:bg-white hover:shadow-md transition-all duration-300 group">
            <div class="w-10 h-10 rounded-full bg-brand-gold/10 text-brand-gold flex items-center justify-center shrink-0 group-hover:bg-brand-gold group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="font-heading font-bold text-brand-navy text-lg group-hover:text-brand-gold transition-colors">{city.name}</div>
              <div class="text-xs text-brand-text-muted font-medium flex items-center gap-2 mt-0.5">
                <span>{city.dept}</span>
                <span class="text-slate-300">•</span>
                <span class="text-brand-navy/70 font-semibold">{city.tag}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center bg-brand-navy/5 border border-brand-navy/10 rounded-xl p-6">
      <p class="text-brand-navy text-sm font-semibold">
        📍 Votre commune n'est pas listée ? Nous nous déplaçons également dans un rayon élargi autour de Narbonne et Béziers. 
        <a href="#devis" class="text-brand-gold font-bold underline hover:text-brand-navy transition-colors ml-1">
          Contactez-nous pour une confirmation immédiate.
        </a>
      </p>
    </div>
  </div>
</section>
